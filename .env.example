# Notion Integration 토큰 (필수)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# 사전예약 / 문의가 쌓이는 Notion DB ID (필수)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 컬럼 이름 매핑 (기본값과 다를 때만 지정) ---
NOTION_PROP_TITLE=이름
NOTION_PROP_EMAIL=이메일
NOTION_PROP_PHONE=연락처
NOTION_PROP_INQUIRY_TYPE=문의 유형
NOTION_PROP_SUBMITTED_DATE=제출일

# 사전예약으로 기록/집계할 '문의 유형' Select 옵션 이름
NOTION_INQUIRY_TYPE_VALUE=사전 예약

# --- 회원탈퇴 ---
# 탈퇴 요청을 별도 DB에 쌓고 싶을 때만 지정 (미지정 시 NOTION_DATABASE_ID 사용)
# NOTION_WITHDRAW_DATABASE_ID=
# 탈퇴 요청에 기록할 '문의 유형' Select 옵션 이름
NOTION_WITHDRAW_TYPE_VALUE=회원 탈퇴
# Notion DB에 텍스트(rich_text) 컬럼을 직접 추가한 경우에만 지정하세요.
# 지정하지 않으면 탈퇴 사유는 페이지 본문에 기록됩니다.
# NOTION_PROP_REASON=탈퇴 사유
